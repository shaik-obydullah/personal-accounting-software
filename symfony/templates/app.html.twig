    }) : activities;
    const total = filtered.length;
    const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
    const pageNum = Math.min(Math.max(1, page), totalPages);
    const rows = filtered.slice((pageNum - 1) * PER_PAGE, pageNum * PER_PAGE);
    el.innerHTML = `
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-2xl font-bold">Activities</h2>
        <div class="relative">
          <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-xs"></i>
          <input id="activity-search" value="${activitySearch}" oninput="activitySearch=this.value; debouncedActivitySearch()" placeholder="Search type, action or IP..." class="bg-gray-700 border border-gray-600 rounded pl-8 pr-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>
      </div>
      <div class="bg-gray-800 rounded-lg overflow-hidden">
        <table class="w-full">
          <thead><tr class="bg-gray-700 text-left text-sm">
            <th class="p-3">Date</th><th class="p-3">Type</th><th class="p-3">Action</th><th class="p-3">IP</th>
          </tr></thead>
          <tbody>
            ${rows.length ? rows.map(a => `
              <tr class="border-t border-gray-700 text-sm">
                <td class="p-3">${a.createdAt ? new Date(a.createdAt).toLocaleString() : '-'}</td>
                <td class="p-3"><span class="px-2 py-0.5 rounded text-xs ${a.type === 'success' ? 'bg-green-900 text-green-300' : a.type === 'warning' ? 'bg-yellow-900 text-yellow-300' : 'bg-red-900 text-red-300'}">${ucfirst(a.type)}</span></td>
                <td class="p-3">${a.name}</td>
                <td class="p-3">${a.ipAddress || '-'}</td>
              </tr>
            `).join('') : '<tr><td colspan="4" class="p-4 text-center text-gray-500">No activities found</td></tr>'}
