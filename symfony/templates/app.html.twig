      </div>
    `;
  } catch (e) {
    el.innerHTML = `<div class="text-red-400">Error: ${e.message}</div>`;
  }
}

// ===== Configurations =====
const REMOVED_CONFIGS = new Set(['meta_title', 'meta_description', 'meta_keyword', 'meta_image', 'meta_url', 'linkedin', 'github']);

const CURRENCY_OPTIONS = [
  {code: 'GBP', name: 'British Pound', symbol: '£'},
  {code: 'USD', name: 'US Dollar', symbol: '$'},
  {code: 'EUR', name: 'Euro', symbol: '€'},
  {code: 'BDT', name: 'Bangladeshi Taka', symbol: '৳'},
  {code: 'INR', name: 'Indian Rupee', symbol: '₹'},
  {code: 'PKR', name: 'Pakistani Rupee', symbol: '₨'},
  {code: 'JPY', name: 'Japanese Yen', symbol: '¥'},
  {code: 'AUD', name: 'Australian Dollar', symbol: 'A$'},
  {code: 'CAD', name: 'Canadian Dollar', symbol: 'C$'},
];

const configLabel = key => key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

async function renderConfigurations() {
  const el = document.getElementById('page-content');
  el.innerHTML = '<div class="text-center py-8"><i class="fas fa-spinner fa-spin text-3xl"></i></div>';
  try {
    const configs = await API.get('/configurations');
    const esc = v => String(v).replace(/'/g, '&#39;');
    const activeCurrencies = (configs.currencies || []).map(c => c.code);
    const defaultCurrency = configs.default_currency || '';
    const rows = Object.entries(configs).filter(([key]) => !REMOVED_CONFIGS.has(key));
    el.innerHTML = `
      <h2 class="text-2xl font-bold mb-4">Settings</h2>
      <div class="bg-gray-800 rounded-lg p-6 space-y-4">
        ${rows.map(([key, value]) => {
          const label = configLabel(key);
          if (key === 'currencies') {
            return `
              <div class="border-b border-gray-700 pb-3">
                <label class="text-gray-400 block mb-2">Currencies</label>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                  ${CURRENCY_OPTIONS.map(c => `
                    <label class="flex items-center gap-2 text-sm bg-gray-900 border border-gray-700 rounded px-3 py-2 cursor-pointer">
                      <input type="checkbox" class="currency-opt" value="${c.code}" data-name="${c.name}" data-symbol="${esc(c.symbol)}" ${activeCurrencies.includes(c.code) ? 'checked' : ''}>
                      ${c.code} - ${c.name} (${c.symbol})
                    </label>
                  `).join('')}
                </div>
                <button onclick="saveConfiguration('${key}')" class="mt-3 bg-blue-600 hover:bg-blue-700 px-3 py-2 rounded text-xs"><i class="fas fa-save mr-1"></i>Save</button>
              </div>`;
          }
          if (key === 'default_currency') {
            return `
              <div class="flex items-center gap-3 border-b border-gray-700 pb-3">
                <label class="text-gray-400 w-48 shrink-0">${label}</label>
                <select id="cfg-${key}" class="flex-1 bg-gray-900 border border-gray-700 rounded px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
                  ${CURRENCY_OPTIONS.map(c => `<option value="${c.code}" ${c.code === defaultCurrency ? 'selected' : ''}>${c.code} - ${c.name}</option>`).join('')}
                </select>
                <button onclick="saveConfiguration('${key}')" class="bg-blue-600 hover:bg-blue-700 px-3 py-2 rounded text-xs shrink-0"><i class="fas fa-save mr-1"></i>Save</button>
              </div>`;
          }
          return `
            <div class="flex items-center gap-3 border-b border-gray-700 pb-3">
              <label class="text-gray-400 w-48 shrink-0">${label}</label>
              <input id="cfg-${key}" type="text" value='${esc(typeof value === 'object' ? JSON.stringify(value) : value)}' class="flex-1 bg-gray-900 border border-gray-700 rounded px-3 py-2 text-sm focus:outline-none focus:border-blue-500" onkeydown="if(event.key==='Enter')saveConfiguration('${key}')">
              <button onclick="saveConfiguration('${key}')" class="bg-blue-600 hover:bg-blue-700 px-3 py-2 rounded text-xs shrink-0"><i class="fas fa-save mr-1"></i>Save</button>
            </div>`;
        }).join('')}
      </div>
    `;
  } catch (e) {
    el.innerHTML = `<div class="text-red-400">Error: ${e.message}</div>`;
  }
}

async function saveConfiguration(key) {
  if (key === 'currencies') {
    const setting = [...document.querySelectorAll('.currency-opt:checked')].map(c => ({
      code: c.value,
      name: c.dataset.name,
      symbol: c.dataset.symbol,
    }));
    try {
      await API.put('/configurations/' + key, {setting});
      showToast('Currencies saved');
      renderConfigurations();
    } catch (e) {
      alert('Error: ' + e.message);
    }
    return;
  }
  const input = document.getElementById('cfg-' + key);
  if (!input) return;
  let value = input.value.trim();
  let setting = value;
  try {
    setting = JSON.parse(value);
  } catch (e) {}
  try {
    await API.put('/configurations/' + key, {setting});
    showToast('Saved ' + key.replace(/_/g, ' '));
  } catch (e) {
    alert('Error: ' + e.message);
  }
}

// ===== Init =====
(async function init() {
  const authed = await checkAuth();
  if (!authed) {
    showLogin();
  }
})();
</script>
