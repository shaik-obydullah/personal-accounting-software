let expenseSearch = '';
const debouncedExpenseSearch = debounce(() => { renderExpenses(1); focusSearch('expense-search'); });

async function renderExpenses(page = 1) {
  const el = document.getElementById('page-content');
  el.innerHTML = '<div class="text-center py-8"><i class="fas fa-spinner fa-spin text-3xl"></i></div>';
  try {
    const [expenses, wallets] = await Promise.all([API.get('/expenses'), API.get('/wallets')]);
    const expenseWallets = wallets.filter(w => w.category === 'expense');
    const q = expenseSearch.trim().toLowerCase();
    const filtered = q ? expenses.filter(e => (e.description || '').toLowerCase().includes(q)) : expenses;
    const total = filtered.length;
    const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
    const pageNum = Math.min(Math.max(1, page), totalPages);
    const rows = filtered.slice((pageNum - 1) * PER_PAGE, pageNum * PER_PAGE);
    el.innerHTML = `
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-2xl font-bold">Expenses</h2>
        <div class="flex gap-2 items-center">
          <div class="relative">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-xs"></i>
            <input id="expense-search" value="${expenseSearch}" oninput="expenseSearch=this.value; debouncedExpenseSearch()" placeholder="Search description..." class="bg-gray-700 border border-gray-600 rounded pl-8 pr-3 py-2 text-sm focus:outline-none focus:border-blue-500">
          </div>
          <button onclick='showExpenseForm(${JSON.stringify(expenseWallets).replace(/'/g, "\\'")})' class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded text-sm"><i class="fas fa-plus mr-1"></i>Add</button>
        </div>
      </div>
      <div class="bg-gray-800 rounded-lg overflow-hidden">
        <table class="w-full">
          <thead><tr class="bg-gray-700 text-left text-sm">
            <th class="p-3">Description</th><th class="p-3">Wallet</th><th class="p-3">Amount</th><th class="p-3">Date</th><th class="p-3">Actions</th>
          </tr></thead>
          <tbody>
            ${rows.length ? rows.map(e => `
              <tr class="border-t border-gray-700 text-sm">
                <td class="p-3">${e.description}</td>
                <td class="p-3">${e.wallet ? e.wallet.name : '-'}</td>
                <td class="p-3 text-red-400">-$${parseFloat(e.amount).toFixed(2)}</td>
                <td class="p-3">${e.createdAt ? new Date(e.createdAt).toLocaleDateString() : '-'}</td>
                <td class="p-3">
                  <button onclick='showExpenseEdit(${JSON.stringify(e).replace(/'/g, "\\'")}, ${JSON.stringify(expenseWallets).replace(/'/g, "\\'")})' class="text-blue-400 hover:text-blue-300 mr-2"><i class="fas fa-edit"></i></button>
