// ===== Cashbook =====
let cashbookSearch = '';
const debouncedCashbookSearch = debounce(() => { renderCashbook(1); focusSearch('cashbook-search'); });

async function renderCashbook(page = 1) {
  const el = document.getElementById('page-content');
  el.innerHTML = '<div class="text-center py-8"><i class="fas fa-spinner fa-spin text-3xl"></i></div>';
  try {
    const entries = await API.get('/cashbook');
    const q = cashbookSearch.trim().toLowerCase();
    const filtered = q ? entries.filter(e => {
      const type = e.inAmount ? 'income' : 'expense';
      return String(e.referenceId || '').includes(q) || type.includes(q) || (e.description || '').toLowerCase().includes(q);
    }) : entries;
    const total = filtered.length;
    const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
    const pageNum = Math.min(Math.max(1, page), totalPages);
    const rows = filtered.slice((pageNum - 1) * PER_PAGE, pageNum * PER_PAGE);
    el.innerHTML = `
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-2xl font-bold">Cashbook</h2>
        <div class="relative">
          <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-xs"></i>
          <input id="cashbook-search" value="${cashbookSearch}" oninput="cashbookSearch=this.value; debouncedCashbookSearch()" placeholder="Search reference, type or description..." class="bg-gray-700 border border-gray-600 rounded pl-8 pr-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>
      </div>
      <div class="bg-gray-800 rounded-lg overflow-hidden">
        <table class="w-full">
          <thead><tr class="bg-gray-700 text-left text-sm">
            <th class="p-3">Date</th><th class="p-3">Description</th><th class="p-3">Type</th><th class="p-3">In</th><th class="p-3">Out</th>
          </tr></thead>
          <tbody>
            ${rows.length ? rows.map(e => `
              <tr class="border-t border-gray-700 text-sm">
                <td class="p-3">${e.createdAt ? new Date(e.createdAt).toLocaleDateString() : '-'}</td>
                <td class="p-3">${e.description || '-'}</td>
                <td class="p-3"><span class="px-2 py-0.5 rounded text-xs ${e.inAmount ? 'bg-green-900 text-green-300' : 'bg-red-900 text-red-300'}">${e.inAmount ? 'Income' : 'Expense'}</span></td>
                <td class="p-3 text-green-400">${e.inAmount ? '$' + parseFloat(e.inAmount).toFixed(2) : ''}</td>
                <td class="p-3 text-red-400">${e.outAmount ? '$' + parseFloat(e.outAmount).toFixed(2) : ''}</td>
              </tr>
            `).join('') : '<tr><td colspan="5" class="p-4 text-center text-gray-500">No entries found</td></tr>'}
          </tbody>
        </table>
        ${totalPages > 1 ? paginationHTML(pageNum, totalPages, total, 'renderCashbook') : ''}
      </div>
    `;
  } catch (e) {
    el.innerHTML = `<div class="text-red-400">Error: ${e.message}</div>`;
  }
}

